{
  "manifest_version": 3,
  "name": "Nuskomate",
  "version": "3.4.5",
  "description": "Smart automation for Masar Nusuk — autofill, reload, translate 0026 more",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "clipboardWrite", "sidePanel", "alarms"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://api.ocr.space/*", "https://*.workers.dev/*", "https://api.github.com/*"],
  "icons": {
    "16":  "images/icon16.png",
    "32":  "images/icon32.png",
    "48":  "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nuskomate@ranakiller59.com",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "images/icon16.png",
      "32":  "images/icon32.png",
      "48":  "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html?panel=1"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/vaccine.jpg"],
      "matches": ["https://*.nusuk.sa/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://masar.nusuk.sa/*"],
      "js": [
        "utils/logger.js",
        "utils/license.js",
        "utils/route-watcher.js",
        "utils/angular-simulator.js",
        "utils/dropdown-helper.js",
        "utils/element-type-detector.js",
        "utils/inspector.js",
        "utils/countries.js",
        "utils/passport-parser.js",
        "modules/auto-reload.js",
        "modules/autofill.js",
        "modules/translation.js",
        "modules/issue-date-calc.js",
        "modules/vaccine-upload.js",
        "modules/disable-loading-overlay.js",
        "modules/ocr.js",
        "modules/batch-passport.js",
        "modules/auto-clicker.js",
        "modules/url-shifter.js",
        "modules/groups-export.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
