{
  "manifest_version": 3,
  "name": "Nuskomate",
  "version": "3.16.0",
  "description": "Smart automation for Masar Nusuk — autofill, reload, translate 0026 more",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "clipboardWrite", "sidePanel", "alarms", "nativeMessaging", "downloads", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16":  "images/icon16.png",
    "32":  "images/icon32.png",
    "48":  "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nuskomate@ranakiller59.com",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "images/icon16.png",
      "32":  "images/icon32.png",
      "48":  "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html?panel=1"
  },
  "commands": {
    "nk-webshot-start": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start Element Screenshot on the current page"
    },
    "nk-open-entities": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open Masar Accounts (entity switcher)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["images/vaccine.jpg"],
      "matches": ["https://*.nusuk.sa/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://masar.nusuk.sa/*"],
      "js": [
        "utils/logger.js",
        "utils/notify.js",
        "utils/license.js",
        "utils/route-watcher.js",
        "utils/angular-simulator.js",
        "utils/dropdown-helper.js",
        "utils/element-type-detector.js",
        "utils/inspector.js",
        "utils/url-match.js",
        "utils/countries.js",
        "utils/passport-parser.js",
        "modules/auto-reload.js",
        "modules/autofill.js",
        "modules/issue-date-calc.js",
        "modules/vaccine-upload.js",
        "modules/disable-loading-overlay.js",
        "utils/image-prep.js",
        "modules/ocr.js",
        "modules/batch-passport.js",
        "modules/auto-clicker.js",
        "modules/url-shifter.js",
        "modules/groups-export.js",
        "modules/brn-request.js",
        "modules/mv-totals.js",
        "modules/talab-copy.js",
        "modules/auto-date-picker.js",
        "modules/package-creator.js",
        "modules/masar-add-mutamer.js",
        "modules/masar-group.js",
        "modules/masar-group-reply.js",
        "modules/masar-accounts.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
